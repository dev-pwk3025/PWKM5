{
  "entities": {
    "Assignment": {
      "title": "Assignment",
      "description": "Classroom AI worksheet assignment with structured prompt fields and max score.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "order": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "mission": { "type": "string", "maxLength": 2000 },
        "description": { "type": "string", "maxLength": 2000 },
        "samplePrompt": { "type": "string", "maxLength": 2000 },
        "sampleImageUrl": { "type": "string", "maxLength": 500 },
        "maxScore": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "order", "title", "mission", "maxScore", "isPublished"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Student weekly Thursday attendance record (20 weeks, 80% threshold).",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 20, "pattern": "^[0-9]+$" },
        "week": { "type": "number" },
        "status": { "type": "string", "enum": ["present", "absent"] },
        "source": { "type": "string", "enum": ["free_credit", "self_checkin", "teacher"] },
        "checkedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["studentId", "week", "status", "source"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student worksheet submission with prompt details, Storage image URL, and teacher grade.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignmentId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 20, "pattern": "^[0-9]+$" },
        "promptText": { "type": "string", "maxLength": 4000 },
        "imageUrl": { "type": "string", "maxLength": 1500 },
        "imageOriginalName": { "type": "string", "maxLength": 200 },
        "score": { "type": "number" },
        "feedback": { "type": "string", "maxLength": 1000 },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "gradedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "assignmentId", "studentId", "submittedAt"]
    }
  },
  "firestore": {
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Published AI classroom worksheets totaling 100 points."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Weekly attendance records keyed by studentId_week."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Student worksheet submissions keyed by assignmentId_studentId."
    }
  }
}
